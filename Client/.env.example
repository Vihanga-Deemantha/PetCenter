# Copy this file to .env and fill in real values. See the root README's
# "Environment Variables" section for what each one does.
# Only VITE_-prefixed variables are ever exposed to the browser bundle.

VITE_API_URL=http://localhost:5011/api/v1

# Optional — must match the server's GOOGLE_CLIENT_ID if set.
VITE_GOOGLE_CLIENT_ID=

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
