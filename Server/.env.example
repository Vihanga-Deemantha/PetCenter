# Copy this file to .env and fill in real values. See the root README's
# "Environment Variables" section for what each one does and whether it's
# required.

PORT=5011
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/petcenter

# Origin(s) allowed to call this API and used to build links in emails.
# Comma-separated for multiple origins (e.g. staging,prod).
CLIENT_URL=http://localhost:5173

# Use two DIFFERENT long random strings — never reuse one secret for both.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# Optional — omitting this disables "Sign in with Google" without breaking anything else.
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Required in production — password-reset emails fail without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PetCenter <no-reply@example.com>"
